---
// 根網址：依瀏覽器語言導向 /zh-TW/ 或 /en/
// Root URL: send visitors to /zh-TW/ or /en/ based on browser language
import { href, defaultLang } from '../i18n/ui';
import { CSP, useMetaCsp } from '../lib/security';
const zh = href('zh-TW/');
const en = href('en/');
const fallback = href(`${defaultLang}/`);
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    {useMetaCsp && <meta http-equiv="Content-Security-Policy" content={CSP} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Developer Intel Hub</title>
    <noscript><meta http-equiv="refresh" content={`0; url=${fallback}`} /></noscript>
    <script is:inline src={href('js/lang-redirect.js')}></script>
  </head>
  <body>
    <p><a href={zh}>繁體中文</a>｜<a href={en}>English</a></p>
  </body>
</html>
