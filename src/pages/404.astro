---
// Netlify 會自動把找不到的網址導到這一頁 / Netlify serves this page for unknown URLs
import { href, langs, t } from '../i18n/ui';
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404｜{t('zh-TW').siteName}</title>
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
  </head>
  <body>
    <main class="nf">
      <p class="code">404</p>
      <h1>找不到這個頁面</h1>
      <p lang="en">This page doesn’t exist.</p>
      <ul>
        {langs.map((l) => (
          <li><a href={href(`${l}/`)} lang={l}>{t(l).siteName}</a></li>
        ))}
      </ul>
    </main>
  </body>
</html>

<style is:global>
  body { margin: 0; font-family: system-ui, -apple-system, 'PingFang TC', 'Microsoft JhengHei', sans-serif; background: #eef2f6; color: #14213d; }
  @media (prefers-color-scheme: dark) { body { background: #0f1720; color: #e6edf5; } a { color: #4fb8c1; } }
  .nf { max-width: 36rem; margin: 15vh auto; padding: 0 1.5rem; }
  .code { font-size: .9rem; letter-spacing: .1em; opacity: .6; margin: 0; }
  h1 { margin: .25rem 0 .5rem; }
  ul { padding-left: 1.1rem; }
  a { color: #0e7c86; }
</style>
