---
import Base from '../../layouts/Base.astro';
import TermCard from '../../components/TermCard.astro';
import GroupIcon from '../../components/GroupIcon.astro';
import ConferenceList from '../../components/ConferenceList.astro';
import { groups, termsIn, conferencesFor, terms } from '../../lib/glossary';
import { langs, t, href, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const s = t(lang);
---
<Base lang={lang} page="learn" title={s.learnTitle}>
  <header class="head">
    <h1>{s.learnTitle}</h1>
    <p class="lede">{s.learnLede}</p>
    <nav class="jump" aria-label={s.learnTitle}>
      {groups.map((g) => (
        <a class:list={['chip', `g-${g.id}`]} href={`#group-${g.id}`}>
          {g.name[lang]} <span class="n num">{termsIn(g.id).length}</span>
        </a>
      ))}
      <a class="chip conf-chip" href="#conferences">{s.confTitle}</a>
    </nav>
  </header>

  <ConferenceList lang={lang} />

  {groups.map((g) => {
    const list = termsIn(g.id);
    const confs = conferencesFor(g.id);
    return (
      <section class:list={['group', `g-${g.id}`]} id={`group-${g.id}`} aria-labelledby={`group-${g.id}-t`}>
        <header class="band">
          <GroupIcon group={g.id} />
          <div>
            <h2 id={`group-${g.id}-t`}>{g.name[lang]}</h2>
            <p>{g.desc[lang]}</p>
          </div>
          <span class="count num">{s.termCount(list.length)}</span>
        </header>
        <div class="cards">
          {list.map((term, i) => <TermCard lang={lang} term={term} featured={i === 0} />)}
        </div>
        {confs.length > 0 && (
          <p class="confs">
            <span class="lbl">{s.confRelated}</span>
            {confs.map((c) => <a href={`#conf-${c.id}`}>{c.name}</a>)}
          </p>
        )}
      </section>
    );
  })}
  <script is:inline src={href('js/learn.js')} defer></script>
</Base>

<style>
  .head { margin: .5rem 0 1.5rem; }
  h1 { font-size: clamp(1.7rem, 4.5vw, 2.3rem); font-weight: 600; letter-spacing: -0.01em; }
  .jump { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
  .chip { text-decoration: none; font-size: .92rem; font-weight: 600; color: var(--g); background: var(--g-bg); border-radius: 999px; padding: .3rem .9rem; display: inline-flex; gap: .45rem; align-items: center; }
  .chip .n { background: var(--surface); border-radius: 999px; padding: 0 .45rem; font-size: .8rem; }
  .conf-chip { color: var(--ink); background: var(--surface); border: 1px solid var(--line); }
  .group { margin-bottom: 2.25rem; scroll-margin-top: 1rem; }
  .band { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center; background: var(--g-bg); border-radius: var(--radius-lg); padding: 1rem 1.25rem; margin-bottom: 1rem; }
  .band h2 { color: var(--g); font-size: 1.4rem; }
  .band p { margin: .1rem 0 0; }
  .count { font-size: .88rem; font-weight: 600; color: var(--g); white-space: nowrap; }
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem; align-items: start; }
  .confs { margin: .9rem 0 0; display: flex; flex-wrap: wrap; gap: .25rem .9rem; font-size: .92rem; align-items: baseline; }
  .lbl { color: var(--muted); }
  @media (max-width: 720px) {
    .cards { grid-template-columns: 1fr; }
    .band { grid-template-columns: auto 1fr; }
    .count { grid-column: 2; }
  }
</style>
