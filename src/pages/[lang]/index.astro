---
import Base from '../../layouts/Base.astro';
import ActionList from '../../components/ActionList.astro';
import NewsList from '../../components/NewsList.astro';
import Sidebar from '../../components/Sidebar.astro';
import VulnTabs from '../../components/VulnTabs.astro';
import EolHint from '../../components/EolHint.astro';
import meta from '../../data/meta.json';
import { langs, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const s = t(lang);
---
<Base lang={lang}>
  <header class="intro">
    <h1>{s.homeTitle}</h1>
    <p>{s.tagline}</p>
    <p class="verified">{s.verified} <time datetime={meta.verifiedOn} class="num">{meta.verifiedOn}</time></p>
  </header>

  <ActionList lang={lang} />

  <div class="grid">
    <NewsList lang={lang} />
    <Sidebar lang={lang} />
  </div>

  <VulnTabs lang={lang} />

  <EolHint lang={lang} />

  <details class="notes">
    <summary>{s.notesTitle}</summary>
    <p>{s.notes}</p>
  </details>
</Base>

<style>
  .intro { margin: 0 0 1.25rem; }
  h1 { margin: 0; font-size: 1.7rem; font-weight: 600; letter-spacing: -0.01em; }
  .intro p { color: var(--muted); margin: .25rem 0 0; max-width: 70ch; }
  .intro .verified { font-size: .88rem; margin-top: .15rem; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 1.25rem; align-items: start; margin-bottom: 1.25rem; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
  }
  .notes { margin-top: 1.5rem; color: var(--muted); font-size: .9rem; max-width: 72ch; }
  .notes summary { cursor: pointer; padding: .5rem 0; }
</style>
