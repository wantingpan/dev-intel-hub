---
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const s = t(Astro.props.lang);
---
<details class="legend">
  <summary>{s.legendTitle}</summary>
  <dl>
    {s.legend.map(([term, desc]) => (
      <div>
        <dt>{term}</dt>
        <dd>{desc}</dd>
      </div>
    ))}
  </dl>
</details>

<style>
  .legend { font-size: .86rem; color: var(--muted); margin: 0 0 .75rem; }
  .legend summary { cursor: pointer; }
  dl { margin: .5rem 0 0; display: grid; gap: .4rem; }
  dt { font-weight: 600; color: var(--ink); }
  dd { margin: 0; max-width: 70ch; }
</style>
