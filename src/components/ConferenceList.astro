---
import { t, formatDate, type Lang } from '../i18n/ui';
import { safeUrl } from '../lib/url';
import { conferences, groups } from '../lib/glossary';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const groupName = (id: string) => groups.find((g) => g.id === id)?.name[lang] ?? id;
const range = (a: string, b: string) => (a === b ? formatDate(a, lang) : `${formatDate(a, lang)} – ${formatDate(b, lang)}`);
---
<section class="conf panel" id="conferences" aria-labelledby="conf-t">
  <h2 id="conf-t">{s.confTitle}</h2>
  <p class="lede">{s.confLede}</p>
  <ol>
    {conferences.map((c) => {
      const u = safeUrl(c.source.url);
      return (
        <li id={`conf-${c.id}`}>
          <div class="when">
            <span class="year num">{c.start.slice(0, 4)}</span>
            <span class="date num">{range(c.start, c.end)}</span>
            <span class="state" data-upcoming-date={c.end} data-past-label={s.passed}>{s.upcoming}</span>
          </div>
          <div class="what">
            <p class="name">{u ? <a href={u} target="_blank" rel="noopener noreferrer">{c.name}</a> : c.name}</p>
            <p class="where">{c.location[lang]}</p>
            {c.note && <p class="note">{c.note[lang]}</p>}
            {c.cfp && (
              <p class="cfp">
                {c.cfp.label[lang]}{lang === 'en' ? ': ' : '：'}<time datetime={c.cfp.date} class="num">{c.cfp.date}</time>
                <span class="state" data-upcoming-date={c.cfp.date} data-past-label={s.passed}>{s.upcoming}</span>
              </p>
            )}
            <p class="tags">
              {c.groups.map((g) => <a class:list={['tag', `g-${g}`]} href={`#group-${g}`}>{groupName(g)}</a>)}
              <span class="srcnote">{c.official ? s.confOfficial : s.confSecondary}{lang === 'en' ? ': ' : '：'}{c.source.name}</span>
            </p>
          </div>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .conf { margin-bottom: 2rem; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 9.5rem 1fr; gap: 1.25rem; padding: 1rem 0; border-top: 1px solid var(--line); scroll-margin-top: 1rem; }
  .when { display: flex; flex-direction: column; gap: .15rem; align-items: flex-start; }
  .year { font-size: .82rem; color: var(--muted); }
  .date { font-weight: 600; font-size: 1.05rem; line-height: 1.3; }
  .state { font-size: .78rem; font-weight: 600; color: var(--accent); border: 1px solid currentColor; border-radius: 4px; padding: 0 .4rem; }
  .state:global(.past) { color: var(--muted); }
  .name { margin: 0; font-weight: 600; font-size: 1.05rem; }
  .where, .note, .cfp { margin: .15rem 0 0; font-size: .94rem; }
  .where { color: var(--muted); }
  .cfp { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
  .tags { margin: .5rem 0 0; display: flex; flex-wrap: wrap; gap: .35rem .5rem; align-items: center; font-size: .84rem; }
  .tag { text-decoration: none; color: var(--g); background: var(--g-bg); border-radius: 999px; padding: .05rem .7rem; font-weight: 600; }
  .srcnote { color: var(--muted); }
  @media (max-width: 620px) { li { grid-template-columns: 1fr; gap: .4rem; } .when { flex-direction: row; flex-wrap: wrap; gap: .5rem; align-items: center; } }
</style>
