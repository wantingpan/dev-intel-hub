---
// 原創分類插圖（內嵌 SVG，顏色隨深淺色模式切換）
// Original category illustrations (inline SVG; colors follow light/dark mode)
import type { Category } from '../i18n/ui';
interface Props { category: Category; size?: number; label?: string }
const { category: c, size = 40, label } = Astro.props;
---
<svg
  class:list={['cat-icon', `cat-${c}`]}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <rect class="bg" width="40" height="40" rx="11" />
  <g class="glyph" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    {c === 'ai' && (
      <>
        <line x1="13" y1="13" x2="27" y2="13" />
        <line x1="13" y1="13" x2="20" y2="27" />
        <line x1="27" y1="13" x2="20" y2="27" />
        <line x1="20" y1="18" x2="13" y2="13" />
        <line x1="20" y1="18" x2="27" y2="13" />
        <line x1="20" y1="18" x2="20" y2="27" />
        <circle class="dot" cx="13" cy="13" r="3" />
        <circle class="dot" cx="27" cy="13" r="3" />
        <circle class="dot" cx="20" cy="27" r="3" />
        <circle class="dot" cx="20" cy="18" r="2.2" />
      </>
    )}
    {c === 'lang' && (
      <>
        <polyline points="14,13 8,20 14,27" />
        <polyline points="26,13 32,20 26,27" />
        <line x1="22.5" y1="11" x2="17.5" y2="29" />
      </>
    )}
    {c === 'cloud' && (
      <>
        <path d="M13 27h15a5.5 5.5 0 0 0 .6-11A8 8 0 0 0 13.4 17 5 5 0 0 0 13 27z" />
        <line x1="17" y1="22" x2="24" y2="22" />
      </>
    )}
    {c === 'security' && (
      <>
        <path d="M20 9l10 4v7c0 6-4.5 9.6-10 11.5C14.5 29.6 10 26 10 20v-7z" />
        <polyline points="15.5,20.5 19,24 25,16.5" />
      </>
    )}
    {c === 'industry' && (
      <>
        <rect x="13" y="13" width="14" height="14" rx="2.5" />
        <rect x="17.5" y="17.5" width="5" height="5" rx="1" />
        <line x1="17" y1="9" x2="17" y2="13" /><line x1="23" y1="9" x2="23" y2="13" />
        <line x1="17" y1="27" x2="17" y2="31" /><line x1="23" y1="27" x2="23" y2="31" />
        <line x1="9" y1="17" x2="13" y2="17" /><line x1="9" y1="23" x2="13" y2="23" />
        <line x1="27" y1="17" x2="31" y2="17" /><line x1="27" y1="23" x2="31" y2="23" />
      </>
    )}
  </g>
</svg>

<style>
  .cat-icon { flex: none; display: block; }
  .cat-ai { --c: var(--c-ai); --cb: var(--c-ai-bg); }
  .cat-lang { --c: var(--c-lang); --cb: var(--c-lang-bg); }
  .cat-cloud { --c: var(--c-cloud); --cb: var(--c-cloud-bg); }
  .cat-security { --c: var(--c-security); --cb: var(--c-security-bg); }
  .cat-industry { --c: var(--c-industry); --cb: var(--c-industry-bg); }
  .bg { fill: var(--cb); }
  .glyph { stroke: var(--c); }
  .dot { fill: var(--cb); }
</style>
