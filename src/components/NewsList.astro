---
import news from '../data/news.json';
import { t, categories, formatDate, href, type Lang } from '../i18n/ui';
import { safeUrl } from '../lib/url';
import DisputeBox from './DisputeBox.astro';
import Legend from './Legend.astro';
import CategoryIcon from './CategoryIcon.astro';
import type { Category } from '../i18n/ui';
import type { Dispute, SourceType } from '../types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const sorted = [...news].sort((a, b) => Number(b.hot) - Number(a.hot) || b.date.localeCompare(a.date));
---
<section class="panel" aria-labelledby="news-title">
  <div class="head">
    <h2 id="news-title">{s.newsTitle}</h2>
    <Legend lang={lang} />
  </div>
  <div class="tabs" role="group" aria-label={s.newsTitle}>
    <button type="button" class="tab" data-cat="" aria-pressed="true">{s.all}</button>
    {categories.map((c) => (
      <button type="button" class="tab" data-cat={c} aria-pressed="false"><CategoryIcon category={c} size={20} />{s.cat[c]}</button>
    ))}
  </div>
  <ul class="news" data-news-list>
    {sorted.map((n) => {
      const url = safeUrl(n.url);
      const count = 1 + n.corroboration.length;
      return (
        <li class="item" data-cat={n.category}>
          <details class="disc">
            <summary>
              <CategoryIcon category={n.category as Category} size={40} label={s.cat[n.category as Category]} />
              <span class="main">
                <span class="title">{n.title[lang]}</span>
                {(n.hot || n.dispute) && (
                  <span class="flags">
                    {n.hot && <span class="flag hot">{s.hot}</span>}
                    {n.dispute && <span class="flag disputed">{s.disputed}</span>}
                  </span>
                )}
                <span class="src"><time datetime={n.date} class="num">{formatDate(n.date, lang)}</time><span>{s.sourceLine(n.source, count)}</span></span>
              </span>
            </summary>
            <div class="body">
              <p class="summary">{n.summary[lang]}</p>
              {n.dispute && <DisputeBox lang={lang} dispute={n.dispute as Dispute} compact />}
              <p class="links">
                {url && <a href={url} target="_blank" rel="noopener noreferrer">{s.readOriginal}</a>}
                <span class="muted">{lang === 'en' ? `${n.source} (${s.srcType[n.sourceType as SourceType]})` : `${n.source}（${s.srcType[n.sourceType as SourceType]}）`}</span>
                {n.corroboration.map((c) => {
                  const u = safeUrl(c.url);
                  return u ? <a href={u} target="_blank" rel="noopener noreferrer">{c.name}</a> : <span>{c.name}</span>;
                })}
              </p>
            </div>
          </details>
        </li>
      );
    })}
  </ul>
  <p class="empty" data-empty hidden>{s.empty}</p>
</section>

<script is:inline src={href('js/news-filter.js')} defer></script>

<style>
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem 1rem; margin-bottom: .75rem; }
  .head :global(.legend) { margin: 0; }
  .tabs { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .5rem; }
  .tab { font: inherit; font-size: .9rem; border: 1px solid var(--line); background: transparent; color: var(--ink); border-radius: 999px; padding: .25rem .9rem .25rem .3rem; cursor: pointer; display: inline-flex; align-items: center; gap: .4rem; }
  .tab:first-child { padding-left: .9rem; }
  .tab[aria-pressed='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .news { list-style: none; margin: 0; padding: 0; }
  .item { border-bottom: 1px solid var(--line); }
  .item:last-child { border-bottom: 0; }
  summary { display: grid; grid-template-columns: 40px 1fr; gap: .9rem; padding: .85rem 0; align-items: start; }
  summary::before { display: none !important; }
  .main { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .6rem; max-width: var(--measure); }
  .title { font-weight: 600; line-height: 1.5; }
  summary:hover .title { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .flags { display: inline-flex; gap: .35rem; }
  .flag { font-size: .78rem; font-weight: 600; border: 1px solid currentColor; border-radius: 4px; padding: 0 .4rem; line-height: 1.6; }
  .hot { color: var(--alert); }
  .disputed { color: var(--warn); }
  .src { flex-basis: 100%; font-size: .88rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 0 .75rem; }
  details[open] .src { display: none; }
  .body { padding: 0 0 1rem calc(40px + .9rem); max-width: calc(var(--measure) + 40px + .9rem); }
  .summary { margin: 0 0 .5rem; }
  .links { margin: 0; display: flex; flex-wrap: wrap; gap: .25rem 1rem; font-size: .9rem; }
  .links a:first-child { font-weight: 600; }
  .muted { color: var(--muted); }
  .empty { color: var(--muted); }
  @media (max-width: 560px) {
    summary { grid-template-columns: 32px 1fr; gap: .7rem; }
    summary :global(.cat-icon) { width: 32px; height: 32px; }
    .body { padding-left: 0; }
  }
</style>
