---
// 名詞分組的原創圖示 / Original icons for glossary groups
import type { GroupId } from '../types';
interface Props { group: GroupId; size?: number }
const { group: g, size = 56 } = Astro.props;
---
<svg class="g-icon" width={size} height={size} viewBox="0 0 56 56" aria-hidden="true" focusable="false">
  <circle class="disc" cx="28" cy="28" r="28" />
  <g class="glyph" fill="none" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
    {g === 'foundations' && (
      <>
        <path d="M28 13l12 5v9c0 8-5.5 12.5-12 15-6.5-2.5-12-7-12-15v-9z" />
        <line x1="22" y1="25" x2="34" y2="25" /><line x1="22" y1="31" x2="30" y2="31" />
      </>
    )}
    {g === 'threats' && (
      <>
        <path d="M28 14L43 40H13z" />
        <line x1="28" y1="24" x2="28" y2="31" /><circle class="fill" cx="28" cy="35.5" r="1.4" />
      </>
    )}
    {g === 'pipeline' && (
      <>
        <circle cx="16" cy="28" r="4.5" /><circle cx="28" cy="28" r="4.5" /><circle cx="40" cy="28" r="4.5" />
        <line x1="20.5" y1="28" x2="23.5" y2="28" /><line x1="32.5" y1="28" x2="35.5" y2="28" />
        <polyline points="37.8,28 39.5,29.8 42.5,26.2" />
      </>
    )}
    {g === 'identity' && (
      <>
        <circle cx="22" cy="28" r="7" />
        <line x1="29" y1="28" x2="43" y2="28" /><line x1="38" y1="28" x2="38" y2="33" /><line x1="43" y1="28" x2="43" y2="32" />
      </>
    )}
    {g === 'reliability' && (
      <polyline points="12,29 20,29 24,19 30,38 34,26 37,29 44,29" />
    )}
  </g>
</svg>

<style>
  .g-icon { flex: none; display: block; }
  .disc { fill: var(--surface); }
  .glyph { stroke: var(--g); }
  .fill { fill: var(--g); }
</style>
