---
import news from '../data/news.json';
import cves from '../data/cves.json';
import { t, categories, type Lang } from '../i18n/ui';
import CategoryIcon from './CategoryIcon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const counts = categories
  .map((c) => ({ c, n: news.filter((x) => x.category === c).length }))
  .sort((a, b) => b.n - a.n);
const max = Math.max(...counts.map((x) => x.n), 1);
const stats = [
  { label: s.total, value: news.length },
  { label: s.hotCount, value: news.filter((x) => x.hot).length },
  { label: s.exploitedCount, value: cves.filter((x) => x.severity === 'exploited').length, alert: true },
];
---
<aside class="side">
  <dl class="stats">
    {stats.map((x) => (
      <div class:list={['stat', { alert: x.alert }]}>
        <dt>{x.label}</dt>
        <dd class="num">{x.value}</dd>
      </div>
    ))}
  </dl>
  <section class="panel" aria-labelledby="mix-title">
    <h2 id="mix-title">{s.mixTitle}</h2>
    <ul class="bars">
      {counts.map(({ c, n }) => (
        <li>
          <span class="label"><CategoryIcon category={c} size={22} />{s.cat[c]}</span>
          <svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
            <rect class="track" width="100" height="8" rx="4" />
            <rect class:list={['fill', `f-${c}`]} width={Math.max(2, (n / max) * 100)} height="8" rx="4" />
          </svg>
          <span class="num count">{n} <span class="unit">{s.items}</span></span>
        </li>
      ))}
    </ul>
  </section>
</aside>

<style>
  .side { display: flex; flex-direction: column; gap: 1rem; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; margin: 0; }
  .stat { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: .7rem .8rem; }
  dt { font-size: .78rem; color: var(--muted); }
  dd { margin: 0; font-size: 1.7rem; font-weight: 600; line-height: 1.2; }
  .alert dd { color: var(--alert); }
  .bars { list-style: none; margin: .75rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .6rem; }
  .bars li { display: grid; grid-template-columns: 1fr auto; gap: .2rem .5rem; font-size: .88rem; }
  .bar { grid-column: 1 / -1; grid-row: 2; width: 100%; height: 8px; display: block; }
  .track { fill: var(--line); }
  .fill { fill: var(--accent); }
  .f-ai { fill: var(--c-ai); } .f-lang { fill: var(--c-lang); } .f-cloud { fill: var(--c-cloud); }
  .f-security { fill: var(--c-security); } .f-industry { fill: var(--c-industry); }
  .label { display: inline-flex; align-items: center; gap: .45rem; }
  .count { font-weight: 600; }
  .unit { font-weight: 400; color: var(--muted); font-size: .8rem; }
</style>
