---
import { t, type Lang } from '../i18n/ui';
import { safeUrl } from '../lib/url';
import { actionTop as top } from '../lib/vulns';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---
<section class="action" aria-labelledby="action-title">
  <h2 id="action-title">{s.actionTitle}</h2>
  <ol class="action-list" data-swipe-list>
    {top.map((c) => (
      <li class:list={['action-item', { exploited: c.severity === 'exploited' }]}>
        <span class="sev">{s.sev[c.severity as keyof typeof s.sev]}</span>
        <span class="what">{c.product[lang]}</span>
        <span class="do">{c.action[lang]}</span>
        {safeUrl(c.url)
          ? <a class="cve num" href={safeUrl(c.url)} target="_blank" rel="noopener noreferrer">{c.cve}</a>
          : <span class="cve num">{c.cve}</span>}
      </li>
    ))}
  </ol>
  <a class="all" href="#patch-list">{s.cveTitle}</a>
</section>

<style>
  .action { margin: .5rem 0 1.5rem; }
  h2 { font-size: clamp(1.35rem, 3.5vw, 1.6rem); font-weight: 600; letter-spacing: -0.01em; margin-bottom: .75rem; }
  .action-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; }
  /* 平板：兩欄；手機：橫向滑動，露出下一張卡片的邊緣，暗示可以滑 / tablet: 2 columns; phone: swipe sideways, with the next card peeking in */
  @media (max-width: 960px) { .action-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .action-list { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: .6rem; margin: 0 calc(-1 * clamp(1rem, 4vw, 2rem)); padding: 0 clamp(1rem, 4vw, 2rem) .5rem; scrollbar-width: none; }
    .action-list::-webkit-scrollbar { display: none; }
    .action-list { scroll-padding: 0 clamp(1rem, 4vw, 2rem); }
    .action-item { flex: 0 0 82%; scroll-snap-align: start; }
    .cve { display: inline-block; padding: .4rem 0; }
  }
  .action-item { background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--muted); border-radius: var(--radius-sm); padding: .9rem 1rem; display: flex; flex-direction: column; gap: .2rem; }
  .action-item.exploited { border-left-color: var(--alert); }
  .sev { font-size: .8rem; font-weight: 600; color: var(--muted); }
  .exploited .sev { color: var(--alert); }
  .what { font-weight: 600; }
  .do { font-size: .92rem; }
  .cve { font-size: .82rem; color: var(--muted); margin-top: .25rem; }
  .all { display: inline-block; margin-top: .5rem; font-size: .9rem; padding: .35rem 0; }
</style>
