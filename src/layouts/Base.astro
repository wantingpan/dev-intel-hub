---
import { languages, langs, href, t, type Lang } from '../i18n/ui';
import { CSP, useMetaCsp } from '../lib/security';
import meta from '../data/meta.json';
// 字型放在網站本身，不向第三方傳送訪客資料 / Self-hosted fonts: no visitor data sent to third parties
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';

interface Props {
  lang: Lang;
  page?: 'today' | 'impact' | 'learn';
  title?: string;
}
const { lang, page = 'today', title } = Astro.props;
const s = t(lang);
const pagePath = (l: string) => (page === 'impact' ? `${l}/impact/` : page === 'learn' ? `${l}/learn/` : `${l}/`);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {useMetaCsp && <meta http-equiv="Content-Security-Policy" content={CSP} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title}｜${s.siteName}` : s.siteName}</title>
    <meta name="description" content={s.tagline} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={href(pagePath(l))} />)}
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : '跳到主要內容'}</a>
    <header class="site-head">
      <a class="brand" href={href(`${lang}/`)}>
        <img src={href('favicon.svg')} alt="" width="28" height="28" />
        <span>{s.siteName}</span>
      </a>
      <nav class="site-nav" aria-label={s.siteName}>
        <a href={href(`${lang}/`)} aria-current={page === 'today' ? 'page' : undefined}>{s.navToday}</a>
        <a href={href(`${lang}/impact/`)} aria-current={page === 'impact' ? 'page' : undefined}>{s.navImpact}</a>
        <a href={href(`${lang}/learn/`)} aria-current={page === 'learn' ? 'page' : undefined}>{s.navLearn}</a>
      </nav>
      <nav class="lang-switch" aria-label={s.switchTo}>
        {
          langs.map((l) => (
            <a href={href(pagePath(l))} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
              {languages[l]}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main">
      <p class="stale-banner" role="status" data-stale-check data-verified={meta.verifiedOn} data-threshold={meta.staleAfterDays} hidden>
        {s.staleA}<time datetime={meta.verifiedOn} class="num">{meta.verifiedOn}</time>{s.staleB}<span class="num" data-stale-days></span>{s.staleC}
      </p>
      <slot />
    </main>
    <script is:inline src={href('js/freshness.js')} defer></script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #eef2f6;
    --surface: #ffffff;
    --ink: #14213d;
    --muted: #55657a;
    --line: #d5dde7;
    --accent: #0e7c86;
    --alert: #b42318;
    --alert-bg: #fdecea;
    --warn: #9a5b00;
    --warn-bg: #fff6e5;
    --warn-line: #f1d9a6;
    --c-ai: #5b45c4; --c-ai-bg: #efeafe;
    --c-lang: #2459b8; --c-lang-bg: #e6eefb;
    --c-cloud: #0e7c86; --c-cloud-bg: #e2f2f3;
    --c-security: #b3364f; --c-security-bg: #fbe8ec;
    --c-industry: #2f7a4c; --c-industry-bg: #e5f2ea;
    /* 中文使用系統內建字型（PingFang TC／微軟正黑體／Noto Sans TC），避免下載大型中文字型檔 */
    --font: 'IBM Plex Sans', 'PingFang TC', 'Microsoft JhengHei', 'Noto Sans TC', system-ui, -apple-system, sans-serif;
    --radius-lg: 14px;
    --radius-sm: 6px;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1720;
      --surface: #17212d;
      --ink: #e6edf5;
      --muted: #9aabbf;
      --line: #2a3747;
      --accent: #4fb8c1;
      --alert: #f97066;
      --alert-bg: #3a1d1b;
      --warn: #f5b84a;
      --warn-bg: #2d2416;
      --warn-line: #5a4520;
      --c-ai: #b6a6ff; --c-ai-bg: #29234a;
      --c-lang: #8fb4ff; --c-lang-bg: #1b2943;
      --c-cloud: #5cc4cc; --c-cloud-bg: #14312f;
      --c-security: #f08aa0; --c-security-bg: #3a1c26;
      --c-industry: #7fd0a0; --c-industry-bg: #17311f;
      color-scheme: dark;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  [hidden] { display: none !important; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    font-size: 1.0625rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  /* 中文需要較寬的行距，每行約 38 字 / CJK reads better with more leading and ~38 characters per line */
  :root { --measure: 66ch; }
  html:lang(zh-TW) body { line-height: 1.8; }
  html:lang(zh-TW) { --measure: 38em; }
  /* 展開元件的共用樣式 / Shared disclosure styling */
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .disc > summary::before { content: ''; display: inline-block; width: .45em; height: .45em; margin-right: .55em; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted); transform: rotate(-45deg); vertical-align: .12em; }
  .disc[open] > summary::before { transform: rotate(45deg); vertical-align: .25em; }
  a { color: var(--accent); }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--surface); padding: .5rem 1rem; z-index: 10; }
  .site-head, main { max-width: 1120px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2rem); }
  .site-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-top: 1.25rem; padding-bottom: 1.25rem; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: .6rem; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 1.05rem; }
  .site-nav { display: flex; gap: 1.25rem; margin-right: auto; margin-left: 1.5rem; }
  .site-nav a { color: var(--muted); text-decoration: none; font-size: .95rem; padding: .2rem 0; border-bottom: 2px solid transparent; }
  .site-nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }
  @media (max-width: 560px) { .site-nav { order: 3; width: 100%; margin-left: 0; } }
  .lang-switch { display: flex; gap: .25rem; }
  .lang-switch a { padding: .25rem .75rem; border-radius: 999px; text-decoration: none; color: var(--muted); font-size: .9rem; }
  .lang-switch a[aria-current='page'] { background: var(--ink); color: var(--bg); }
  main { padding-bottom: 4rem; }
  .stale-banner { margin: 0 0 1.25rem; padding: .7rem 1rem; border: 1px solid var(--warn-line); background: var(--warn-bg); color: var(--ink); border-radius: var(--radius-sm); font-size: .92rem; }
  h1, h2 { line-height: 1.25; margin: 0; }
  h2 { font-size: 1.25rem; font-weight: 600; }
  .lede { color: var(--muted); margin: .35rem 0 1rem; font-size: .95rem; max-width: var(--measure); }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1rem, 3vw, 1.5rem); }
  .num { font-variant-numeric: tabular-nums; }
</style>
