---
import { languages, langs, href, t, type Lang } from '../i18n/ui';
import { CSP, useMetaCsp } from '../lib/security';
// 字型放在網站本身，不向第三方傳送訪客資料 / Self-hosted fonts: no visitor data sent to third parties
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';

interface Props {
  lang: Lang;
  page?: 'today' | 'impact';
  title?: string;
}
const { lang, page = 'today', title } = Astro.props;
const s = t(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {useMetaCsp && <meta http-equiv="Content-Security-Policy" content={CSP} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title}｜${s.siteName}` : s.siteName}</title>
    <meta name="description" content={s.tagline} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={href(page === 'impact' ? `${l}/impact/` : `${l}/`)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : '跳到主要內容'}</a>
    <header class="site-head">
      <a class="brand" href={href(`${lang}/`)}>
        <img src={href('favicon.svg')} alt="" width="28" height="28" />
        <span>{s.siteName}</span>
      </a>
      <nav class="site-nav" aria-label={s.siteName}>
        <a href={href(`${lang}/`)} aria-current={page === 'today' ? 'page' : undefined}>{s.navToday}</a>
        <a href={href(`${lang}/impact/`)} aria-current={page === 'impact' ? 'page' : undefined}>{s.navImpact}</a>
      </nav>
      <nav class="lang-switch" aria-label={s.switchTo}>
        {
          langs.map((l) => (
            <a href={href(page === 'impact' ? `${l}/impact/` : `${l}/`)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
              {languages[l]}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #eef2f6;
    --surface: #ffffff;
    --ink: #14213d;
    --muted: #55657a;
    --line: #d5dde7;
    --accent: #0e7c86;
    --alert: #b42318;
    --alert-bg: #fdecea;
    --warn: #9a5b00;
    --warn-bg: #fff6e5;
    --warn-line: #f1d9a6;
    /* 中文使用系統內建字型（PingFang TC／微軟正黑體／Noto Sans TC），避免下載大型中文字型檔 */
    --font: 'IBM Plex Sans', 'PingFang TC', 'Microsoft JhengHei', 'Noto Sans TC', system-ui, -apple-system, sans-serif;
    --radius-lg: 14px;
    --radius-sm: 6px;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1720;
      --surface: #17212d;
      --ink: #e6edf5;
      --muted: #9aabbf;
      --line: #2a3747;
      --accent: #4fb8c1;
      --alert: #f97066;
      --alert-bg: #3a1d1b;
      --warn: #f5b84a;
      --warn-bg: #2d2416;
      --warn-line: #5a4520;
      color-scheme: dark;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    font-size: 1rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--accent); }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--surface); padding: .5rem 1rem; z-index: 10; }
  .site-head, main { max-width: 1120px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2rem); }
  .site-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-top: 1.25rem; padding-bottom: 1.25rem; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: .6rem; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 1.05rem; }
  .site-nav { display: flex; gap: 1.25rem; margin-right: auto; margin-left: 1.5rem; }
  .site-nav a { color: var(--muted); text-decoration: none; font-size: .95rem; padding: .2rem 0; border-bottom: 2px solid transparent; }
  .site-nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }
  @media (max-width: 560px) { .site-nav { order: 3; width: 100%; margin-left: 0; } }
  .lang-switch { display: flex; gap: .25rem; }
  .lang-switch a { padding: .25rem .75rem; border-radius: 999px; text-decoration: none; color: var(--muted); font-size: .9rem; }
  .lang-switch a[aria-current='page'] { background: var(--ink); color: var(--bg); }
  main { padding-bottom: 4rem; }
  h1, h2 { line-height: 1.25; margin: 0; }
  h2 { font-size: 1.25rem; font-weight: 600; }
  .lede { color: var(--muted); margin: .35rem 0 1rem; font-size: .92rem; }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1rem, 3vw, 1.5rem); }
  .num { font-variant-numeric: tabular-nums; }
</style>
